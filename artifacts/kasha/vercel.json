{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.kashaonline.in/api/:path*"
    },
    {
      "source": "/products/:id",
      "destination": "https://api.kashaonline.in/seo/products/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
